---
import Svg from '@components/diagram/Svg.astro';
import type { LangCode } from '@i18n/languages';

interface Props {
  lang: LangCode;
}
const strings = {
  en: {
    title: 'A home-made electromagnet',
    desc: 'An insulated wire is wound many times around an iron nail, and its two ends touch a battery. Current in the coil turns the nail into a magnet that picks up paper clips.',
    nail: 'iron nail',
    coil: 'wire coil',
    battery: 'AA battery',
    clips: 'paper clips',
  },
  sk: {
    title: 'Domáci elektromagnet',
    desc: 'Izolovaný drôt je veľakrát omotaný okolo železného klinca a jeho dva konce sa dotýkajú batérie. Prúd v cievke zmení klinec na magnet, ktorý zdvíha kancelárske spinky.',
    nail: 'železný klinec',
    coil: 'cievka z drôtu',
    battery: 'batéria AA',
    clips: 'spinky',
  },
} as const;
const s = strings[Astro.props.lang];
const turns = Array.from({ length: 12 }, (_, i) => 118 + i * 14);
---
<Svg viewBox="0 0 400 230" title={s.title} desc={s.desc} maxWidth="30rem">
  <rect x="90" y="92" width="220" height="18" rx="4" class="d-box-alt" />
  <path d="M310 92l24 9-24 9z" class="d-box-alt" />
  {turns.map((x) => <ellipse cx={x} cy="101" rx="5" ry="18" fill="none" stroke="var(--d-hot)" stroke-width="3" />)}
  <path d="M118 119V170H160M272 119V170H240" fill="none" stroke="var(--d-hot)" stroke-width="3" />
  <rect x="160" y="156" width="80" height="30" rx="6" class="d-box" />
  <text x="200" y="208" text-anchor="middle" class="d-small">{s.battery}</text>
  <path d="M338 116c6 10 6 18 0 26M346 142c8 6 12 14 8 22" fill="none" stroke="var(--d-muted)" stroke-width="3" stroke-linecap="round" />
  <text x="200" y="70" text-anchor="middle" class="d-small">{s.coil}</text>
  <text x="90" y="86" class="d-small d-muted">{s.nail}</text>
  <text x="392" y="190" text-anchor="end" class="d-small">{s.clips}</text>
</Svg>
