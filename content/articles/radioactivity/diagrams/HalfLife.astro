---
import Svg from '@components/diagram/Svg.astro';
import type { LangCode } from '@i18n/languages';

interface Props {
  lang: LangCode;
}
const strings = {
  en: {
    title: 'Half-life: half of what is left changes each time',
    desc: 'Four squares, each with the same 16 radioactive atoms. At the start, all 16 are unchanged. After one half-life, 8 are left. After two half-lives, 4 are left, and after three half-lives, 2. The atoms that changed are drawn in another colour, and they are scattered at random.',
    steps: ['start', '1 half-life', '2 half-lives', '3 half-lives'],
    time: 'time',
    left: 'not changed yet',
    changed: 'changed into another element',
  },
  sk: {
    title: 'Polčas rozpadu: zakaždým sa zmení polovica toho, čo zostalo',
    desc: 'Štyri štvorce, v každom tých istých 16 rádioaktívnych atómov. Na začiatku je všetkých 16 nezmenených. Po jednom polčase rozpadu ich zostáva 8. Po dvoch polčasoch 4 a po troch polčasoch 2. Atómy, ktoré sa zmenili, majú inú farbu a sú rozhádzané náhodne.',
    steps: ['začiatok', '1 polčas', '2 polčasy', '3 polčasy'],
    time: 'čas',
    left: 'ešte nezmenený',
    changed: 'zmenil sa na iný prvok',
  },
} as const;
const s = strings[Astro.props.lang];

// The step at which each of the 16 atoms changes (0 = never in this picture): 8 at step 1,
// 4 more at step 2, 2 more at step 3, scattered so no pattern shows.
const CHANGES = [1, 0, 2, 1, 3, 1, 2, 1, 1, 2, 0, 3, 2, 1, 1, 1];
const XS = [50, 150, 250, 350];
const GRID_TOP = 22;
const atoms = CHANGES.map((step, i) => ({ step, dx: (i % 4) * 19 - 28.5, dy: Math.floor(i / 4) * 19 }));
---
<Svg viewBox="0 0 400 232" title={s.title} desc={s.desc} maxWidth="30rem">
  {XS.map((x) => <rect x={x - 42} y={GRID_TOP - 13} width="84" height="84" rx="10" class="d-box-alt" style="stroke-width: 1.5" />)}
  {
    XS.map((x, panel) =>
      atoms.map(({ step, dx, dy }) => (
        <circle cx={x + dx} cy={GRID_TOP + dy} r="7" class={step > 0 && step <= panel ? 'd-cool' : 'd-positive'} />
      )),
    )
  }
  {XS.map((x, i) => <text x={x} y="112" text-anchor="middle" class="d-small">{s.steps[i]}</text>)}
  {XS.map((x, i) => <text x={x} y="136" text-anchor="middle" class="d-label">{16 / 2 ** i}</text>)}
  <path d="M20 152H350" class="d-line d-arrow" />
  <text x="358" y="157" class="d-small">{s.time}</text>
  <circle cx="32" cy="186" r="7" class="d-positive" />
  <text x="46" y="191" class="d-small">{s.left}</text>
  <circle cx="32" cy="214" r="7" class="d-cool" />
  <text x="46" y="219" class="d-small">{s.changed}</text>
</Svg>
