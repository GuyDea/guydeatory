---
import Svg from '@components/diagram/Svg.astro';
import type { LangCode } from '@i18n/languages';

interface Props {
  lang: LangCode;
}
const strings = {
  en: {
    title: 'A hot cup of tea and a warm bath',
    desc: 'On the left, a small cup of hot tea at 80 °C. On the right, a big bathtub of warm water at 38 °C. The tea is hotter, but the bath holds much more heat energy because it has so much more water.',
    tea: 'hot tea',
    bath: 'warm bath',
    teaTemp: '80 °C',
    bathTemp: '38 °C',
    teaNote: 'hotter',
    bathNote: 'much more heat energy',
  },
  sk: {
    title: 'Hrnček horúceho čaju a teplý kúpeľ',
    desc: 'Vľavo je malý hrnček horúceho čaju s teplotou 80 °C. Vpravo je veľká vaňa teplej vody s teplotou 38 °C. Čaj je teplejší, ale vaňa má v sebe oveľa viac tepelnej energie, pretože je v nej oveľa viac vody.',
    tea: 'horúci čaj',
    bath: 'teplý kúpeľ',
    teaTemp: '80 °C',
    bathTemp: '38 °C',
    teaNote: 'je teplejší',
    bathNote: 'oveľa viac tepelnej energie',
  },
} as const;
const s = strings[Astro.props.lang];
---
<Svg viewBox="0 0 400 280" title={s.title} desc={s.desc} maxWidth="30rem">
  <path d="M60 104c-6-8 6-14 0-22M80 100c-6-8 6-14 0-22" class="d-line" style="stroke: var(--d-muted)" />
  <path d="M30 115H110V180C110 196 98 206 82 206H58C42 206 30 196 30 180Z" class="d-box" />
  <path d="M34 127H106V179C106 192 96 202 82 202H58C44 202 34 192 34 179Z" class="d-hot" />
  <path d="M110 132C132 132 134 172 110 172" class="d-line" style="stroke-width: 5" />
  <text x="72" y="70" text-anchor="middle" class="d-label">{s.tea}</text>

  <path d="M378 130V104H352" class="d-line" style="stroke-width: 5" />
  <path d="M160 130H390V168C390 196 370 212 344 212H206C180 212 160 196 160 168Z" class="d-box" />
  <path d="M166 142H384V168C384 192 366 206 344 206H206C184 206 166 192 166 168Z" class="d-warm" />
  <circle cx="200" cy="222" r="7" class="d-box" />
  <circle cx="350" cy="222" r="7" class="d-box" />
  <text x="270" y="100" text-anchor="middle" class="d-label">{s.bath}</text>

  <text x="72" y="252" text-anchor="middle" class="d-label">{s.teaTemp}</text>
  <text x="72" y="274" text-anchor="middle" class="d-small">{s.teaNote}</text>
  <text x="275" y="252" text-anchor="middle" class="d-label">{s.bathTemp}</text>
  <text x="275" y="274" text-anchor="middle" class="d-small">{s.bathNote}</text>
</Svg>
