---
import Svg from '@components/diagram/Svg.astro';
import type { LangCode } from '@i18n/languages';

interface Props {
  lang: LangCode;
}
const strings = {
  en: {
    title: 'Molecules, single atoms, a crystal of ions and a metal',
    desc: 'Four boxes. Water: separate little molecules, each an oxygen atom with two hydrogen atoms. Helium: single atoms, each on its own. Salt: a grid of plus and minus ions with no separate molecules. Copper: plus metal ions in rows, surrounded by a sea of free electrons.',
    names: ['water', 'helium', 'salt', 'copper'],
    kinds: ['separate molecules', 'single atoms', 'a crystal of ions', 'ions in an electron sea'],
  },
  sk: {
    title: 'Molekuly, samostatné atómy, kryštál z iónov a kov',
    desc: 'Štyri škatule. Voda: samostatné malé molekuly, každá z atómu kyslíka a dvoch atómov vodíka. Hélium: samostatné atómy, každý sám. Soľ: mriežka z kladných a záporných iónov bez samostatných molekúl. Meď: kladné ióny kovu v radoch, obklopené morom voľných elektrónov.',
    names: ['voda', 'hélium', 'soľ', 'meď'],
    kinds: ['samostatné molekuly', 'samostatné atómy', 'kryštál z iónov', 'ióny v mori elektrónov'],
  },
} as const;
const s = strings[Astro.props.lang];
const f = (n: number) => n.toFixed(1);

// The four boxes: [left, top]; each is 190 wide and 130 tall.
const boxes = [
  [5, 32],
  [205, 32],
  [5, 228],
  [205, 228],
];
const sign = 'stroke: var(--d-fill); stroke-width: 2.5; stroke-linecap: round';

// Water: [x, y, direction the molecule points in degrees]; H atoms 16 from O, 104.5° apart.
const waters = [
  [42, 68, 80], [104, 60, 150], [160, 78, 40], [66, 124, 300], [132, 128, 220],
];
const half = 52.25;
const hAt = (x: number, y: number, deg: number, side: number) => {
  const a = ((deg + side * half) * Math.PI) / 180;
  return [x + 16 * Math.cos(a), y + 16 * Math.sin(a)];
};
// Helium atoms scattered on their own.
const helium = [
  [240, 62], [306, 54], [364, 80], [262, 118], [336, 132], [226, 144],
];
// Salt: a checkerboard of Cl⁻ (big, minus) and Na⁺ (small, plus).
const salt = Array.from({ length: 3 }, (_, row) =>
  Array.from({ length: 5 }, (_, col) => ({ x: 30 + col * 35, y: 258 + row * 36, chloride: (row + col) % 2 === 0 })),
).flat();
// Copper: rows of plus ions with free electrons between them.
const ions = Array.from({ length: 3 }, (_, row) => Array.from({ length: 4 }, (_, col) => [236 + col * 44, 258 + row * 36])).flat();
const electrons = [
  [258, 276], [302, 276], [346, 276], [258, 312], [302, 312], [346, 312], [216, 240], [386, 276], [224, 348], [368, 348],
];
---
<Svg viewBox="0 0 400 392" title={s.title} desc={s.desc} maxWidth="30rem">
  {
    boxes.map(([x, y], i) => (
      <g>
        <text x={x + 95} y={y - 10} text-anchor="middle" class="d-label">{s.names[i]}</text>
        <rect x={x} y={y} width="190" height="130" rx="10" class="d-box" />
        <text x={x + 95} y={y + 152} text-anchor="middle" class="d-small">{s.kinds[i]}</text>
      </g>
    ))
  }

  {waters.map(([x, y, deg]) => [-1, 1].map((side) => {
    const [hx, hy] = hAt(x, y, deg, side);
    return <path d={`M${x} ${y}L${f(hx)} ${f(hy)}`} class="d-line" stroke-width="2.5" />;
  }))}
  {waters.map(([x, y]) => <circle cx={x} cy={y} r="10" class="d-box-alt" />)}
  {waters.map(([x, y, deg]) => [-1, 1].map((side) => {
    const [hx, hy] = hAt(x, y, deg, side);
    return <circle cx={f(hx)} cy={f(hy)} r="6.5" class="d-box" />;
  }))}

  {helium.map(([x, y]) => <circle cx={x} cy={y} r="10" class="d-cool" style="stroke: var(--d-ink); stroke-width: 2" />)}

  {
    salt.map(({ x, y, chloride }) =>
      chloride ? (
        <g>
          <circle cx={x} cy={y} r="13" class="d-electron" />
          <path d={`M${x - 5} ${y}H${x + 5}`} style={sign} />
        </g>
      ) : (
        <g>
          <circle cx={x} cy={y} r="8" class="d-positive" />
          <path d={`M${x - 4} ${y}H${x + 4}M${x} ${y - 4}V${y + 4}`} style={sign} />
        </g>
      ),
    )
  }

  <rect x="205" y="228" width="190" height="130" rx="10" class="d-cool" opacity="0.18" />
  {ions.map(([x, y]) => <circle cx={x} cy={y} r="11" class="d-positive" />)}
  {ions.map(([x, y]) => <path d={`M${x - 5} ${y}H${x + 5}M${x} ${y - 5}V${y + 5}`} style={sign} />)}
  {electrons.map(([x, y]) => <circle cx={x} cy={y} r="4" class="d-electron" />)}
</Svg>
