---
import Svg from '@components/diagram/Svg.astro';
import type { LangCode } from '@i18n/languages';

interface Props {
  lang: LangCode;
}
const strings = {
  en: {
    title: 'Water is a polar molecule',
    desc: 'A large water molecule: an oxygen atom at the top and two hydrogen atoms below it, 104.5° apart. The shared electrons in each bond sit closer to the oxygen than to the hydrogen. A bluish haze around the oxygen marks its slightly negative side, δ−. An orange haze around each hydrogen marks the slightly positive side, δ+.',
    minus: 'slightly minus',
    plus: 'slightly plus',
    angle: '104.5°',
    pull: 'oxygen pulls the shared electrons closer',
  },
  sk: {
    title: 'Voda je polárna molekula',
    desc: 'Veľká molekula vody: hore atóm kyslíka a pod ním dva atómy vodíka, ktoré zvierajú uhol 104,5°. Spoločné elektróny v každej väzbe sú bližšie ku kyslíku ako k vodíku. Modrastý opar okolo kyslíka označuje jeho trochu zápornú stranu δ−. Oranžový opar okolo každého vodíka označuje trochu kladnú stranu δ+.',
    minus: 'trochu mínus',
    plus: 'trochu plus',
    angle: '104,5°',
    pull: 'kyslík si pritiahne spoločné elektróny',
  },
} as const;
const s = strings[Astro.props.lang];
const f = (n: number) => n.toFixed(1);

const o = { x: 200, y: 96 };
const half = (104.5 / 2) * (Math.PI / 180);
const bond = 92;
const hydrogens = [-1, 1].map((side) => ({ x: o.x + side * bond * Math.sin(half), y: o.y + bond * Math.cos(half), side }));
// Shared pair on each bond: in the gap between the atoms, but nearer the oxygen; the two dots sit across the bond.
const pairs = hydrogens.flatMap(({ x, y }) => {
  const t = 0.47;
  const px = o.x + (x - o.x) * t;
  const py = o.y + (y - o.y) * t;
  const len = Math.hypot(x - o.x, y - o.y);
  const nx = (-(y - o.y) / len) * 6;
  const ny = ((x - o.x) / len) * 6;
  return [
    [px + nx, py + ny],
    [px - nx, py - ny],
  ];
});
const arcR = 50;
const arcFrom = [o.x - arcR * Math.sin(half), o.y + arcR * Math.cos(half)];
const arcTo = [o.x + arcR * Math.sin(half), o.y + arcR * Math.cos(half)];
---
<Svg viewBox="0 0 400 290" title={s.title} desc={s.desc} maxWidth="30rem">
  <ellipse cx={o.x} cy={o.y - 6} rx="68" ry="58" class="d-electron" opacity="0.16" />
  {hydrogens.map(({ x, y }) => <circle cx={f(x)} cy={f(y)} r="38" class="d-positive" opacity="0.14" />)}
  {hydrogens.map(({ x, y }) => <path d={`M${o.x} ${o.y}L${f(x)} ${f(y)}`} class="d-line" stroke-width="3" />)}
  <path d={`M${f(arcFrom[0])} ${f(arcFrom[1])}A${arcR} ${arcR} 0 0 0 ${f(arcTo[0])} ${f(arcTo[1])}`} class="d-line" style="stroke: var(--d-muted)" />
  <text x={o.x} y={o.y + 76} text-anchor="middle" class="d-small">{s.angle}</text>
  <circle cx={o.x} cy={o.y} r="34" class="d-box-alt" />
  <text x={o.x} y={o.y + 9} text-anchor="middle" class="d-label" style="font-size: 26px">O</text>
  {hydrogens.map(({ x, y }) => <circle cx={f(x)} cy={f(y)} r="23" class="d-box" />)}
  {hydrogens.map(({ x, y }) => <text x={f(x)} y={f(y + 8)} text-anchor="middle" class="d-label" style="font-size: 22px">H</text>)}
  {pairs.map(([x, y]) => <circle cx={f(x)} cy={f(y)} r="5" class="d-electron" />)}

  <text x={o.x + 62} y="38" class="d-label" style="fill: var(--d-electron); font-size: 26px">δ−</text>
  <text x={o.x + 100} y="36" class="d-small">{s.minus}</text>
  {hydrogens.map(({ x, y, side }) => (
    <text x={f(x + side * 26)} y={f(y + 52)} text-anchor="middle" class="d-label" style="fill: var(--d-positive); font-size: 26px">δ+</text>
  ))}
  {hydrogens.map(({ x, y, side }) => <text x={f(x + side * 26)} y={f(y + 74)} text-anchor="middle" class="d-small">{s.plus}</text>)}
  <text x={o.x} y="280" text-anchor="middle" class="d-small d-muted">{s.pull}</text>
</Svg>
