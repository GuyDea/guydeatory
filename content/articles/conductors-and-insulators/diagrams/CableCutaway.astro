---
import Svg from '@components/diagram/Svg.astro';
import type { LangCode } from '@i18n/languages';

interface Props {
  lang: LangCode;
}
const strings = {
  en: {
    title: 'A cable with a window cut into it',
    desc: 'A cable covered in plastic. A window cut into the plastic shows the copper wire running inside it, and at the end of the cable the copper sticks out. Electrons move along the copper. The copper is a conductor and the plastic is an insulator.',
    plastic: 'plastic: insulator',
    copper: 'copper: conductor',
  },
  sk: {
    title: 'Kábel s vyrezaným okienkom',
    desc: 'Kábel obalený plastom. Okienko vyrezané v plaste ukazuje medený drôt, ktorý vedie vnútri, a na konci kábla meď vytŕča von. Meďou sa pohybujú elektróny. Meď je vodič a plast je izolant.',
    plastic: 'plast: izolant',
    copper: 'meď: vodič',
  },
} as const;
const s = strings[Astro.props.lang];
const electrons = [118, 148, 178, 292, 322, 352];
---
<Svg viewBox="0 0 400 170" title={s.title} desc={s.desc} maxWidth="30rem">
  <rect x="60" y="80" width="316" height="28" rx="6" class="d-box d-warm" />
  <path d="M96 62H22Q12 62 12 72V116Q12 126 22 126H96Z" class="d-box-alt" />
  <rect x="200" y="62" width="62" height="64" class="d-box-alt" />
  <rect x="96" y="62" width="104" height="64" class="d-line" stroke-dasharray="5 4" style="stroke: var(--d-muted)" />
  {electrons.map((x) => <circle cx={x} cy="94" r="5" class="d-electron" />)}
  <path d="M286 68H356" class="d-line d-arrow-electron" />
  <text x="24" y="44" class="d-label">{s.plastic}</text>
  <text x="376" y="152" text-anchor="end" class="d-label">{s.copper}</text>
</Svg>
