{
  "name": "guydeatory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Guydeatory — how things work, explained from the very beginning (theguydea.com)",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "astro check",
    "lint:content": "tsx scripts/lint-content.ts",
    "new:article": "tsx scripts/new-article.ts",
    "check": "astro check && vitest run && npm run lint:content && npm run build && npm run check:dist",
    "deploy": "bash scripts/deploy.sh",
    "infra:deploy": "bash scripts/infra-deploy.sh",
    "check:dist": "tsx scripts/check-dist.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/svelte": "^9.0.1",
    "astro": "^7.3.5",
    "katex": "^0.18.9",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "svelte": "^5.57.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@mdx-js/mdx": "^3.1.1",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.3",
    "@types/unist": "^3.0.3",
    "gray-matter": "^4.0.3",
    "mdast-util-mdx-jsx": "^3.2.0",
    "node-html-parser": "^9.0.4",
    "pagefind": "^1.5.2",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vfile": "^6.0.3",
    "vitest": "^5.0.2",
    "yaml": "^2.9.1"
  }
}
