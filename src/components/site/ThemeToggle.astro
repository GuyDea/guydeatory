---
import type { LangCode } from '@i18n/languages';
import { t } from '@i18n/t';

interface Props {
  lang: LangCode;
}
const { lang } = Astro.props;
const labels = {
  system: t(lang, 'theme.label', { mode: t(lang, 'theme.system') }),
  light: t(lang, 'theme.label', { mode: t(lang, 'theme.light') }),
  dark: t(lang, 'theme.label', { mode: t(lang, 'theme.dark') }),
};
---
<button
  type="button"
  class="theme-toggle"
  data-theme-toggle
  data-mode="system"
  data-label-system={labels.system}
  data-label-light={labels.light}
  data-label-dark={labels.dark}
  aria-label={labels.system}
  title={labels.system}
>
  <svg class="icon icon-system" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="2"></circle>
    <path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor"></path>
  </svg>
  <svg class="icon icon-light" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="4.5" fill="currentColor"></circle>
    <path
      d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"></path>
  </svg>
  <svg class="icon icon-dark" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z" fill="currentColor"></path>
  </svg>
</button>

<script>
  type Mode = 'system' | 'light' | 'dark';
  const ORDER: Mode[] = ['system', 'light', 'dark'];

  function stored(): Mode {
    try {
      const value = localStorage.getItem('theme');
      return value === 'light' || value === 'dark' ? value : 'system';
    } catch {
      return 'system';
    }
  }

  function apply(mode: Mode) {
    const root = document.documentElement;
    if (mode === 'system') delete root.dataset.theme;
    else root.dataset.theme = mode;
    try {
      if (mode === 'system') localStorage.removeItem('theme');
      else localStorage.setItem('theme', mode);
    } catch {
      /* storage unavailable: the choice lasts for this page only */
    }
    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
      button.dataset.mode = mode;
      const label = button.dataset[`label${mode[0]!.toUpperCase()}${mode.slice(1)}`] ?? '';
      button.setAttribute('aria-label', label);
      button.title = label;
    }
  }

  apply(stored());
  document.addEventListener('click', (event) => {
    if (!(event.target as Element | null)?.closest('[data-theme-toggle]')) return;
    const next = ORDER[(ORDER.indexOf(stored()) + 1) % ORDER.length]!;
    apply(next);
  });
</script>

<style>
  .theme-toggle {
    display: grid;
    place-items: center;
    width: var(--touch);
    height: var(--touch);
    border: 0;
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--ink-soft);
  }

  .theme-toggle:hover {
    background: var(--surface-sunk);
    color: var(--ink);
  }

  .icon {
    width: 22px;
    height: 22px;
    display: none;
  }

  [data-mode='system'] .icon-system,
  [data-mode='light'] .icon-light,
  [data-mode='dark'] .icon-dark {
    display: block;
  }
</style>
