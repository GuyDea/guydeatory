---
import type { LangCode } from '@i18n/languages';
import { t } from '@i18n/t';

interface Props {
  lang: LangCode;
  summary: string;
}
const { lang, summary } = Astro.props;
---
<section class="short-answer" aria-labelledby="short-answer-title">
  <h2 id="short-answer-title" class="tab" data-pagefind-ignore>{t(lang, 'article.shortAnswer')}</h2>
  <p data-pagefind-meta="summary">{summary}</p>
</section>

<style>
  .short-answer {
    position: relative;
    max-width: var(--measure);
    margin-top: var(--space-6);
    padding: var(--space-5) var(--space-5) var(--space-5);
    background: var(--surface);
    border: 2px solid var(--ink);
    border-radius: 0 var(--radius-md) var(--radius-md) var(--radius-md);
    box-shadow: 6px 6px 0 var(--highlight);
  }

  /* A folder tab sticking out of the placard. */
  .tab {
    position: absolute;
    left: -2px;
    bottom: 100%;
    padding: 0.2em 0.9em 0.1em;
    background: var(--ink);
    color: var(--paper);
    border-radius: var(--radius-sm) var(--radius-sm) 0 0;
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  p {
    font-size: var(--text-lg);
    line-height: 1.5;
  }
</style>
