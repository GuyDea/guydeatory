---
import type { LangCode } from '@i18n/languages';
import { t } from '@i18n/t';
import { localized } from '@lib/content/queries';
import type { Label } from '@lib/content/types';
import { sectionUrl } from '@lib/urls';

interface Props {
  lang: LangCode;
  label: Label;
  /** Render as a link to Explore filtered by this label (default) or as plain text. */
  link?: boolean;
}
const { lang, label, link = true } = Astro.props;
const name = localized(label.name, lang);
const style = `--chip: var(--label-${label.color}); --chip-bg: var(--label-${label.color}-bg)`;
---
{
  link ? (
    <a class="chip" style={style} href={`${sectionUrl(lang, 'explore')}?label=${label.id}`} title={t(lang, 'label.seeAll', { label: name })}>
      {name}
    </a>
  ) : (
    <span class="chip" style={style}>{name}</span>
  )
}

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    min-height: 32px;
    padding: 0.1em 0.75em 0.1em 0.6em;
    border-radius: var(--radius-pill);
    background: var(--chip-bg);
    color: var(--chip);
    font-family: var(--font-display-stack);
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    white-space: nowrap;
  }

  .chip::before {
    content: '';
    width: 0.55em;
    height: 0.55em;
    border-radius: 50%;
    background: currentColor;
  }

  a.chip:hover {
    box-shadow: inset 0 0 0 2px var(--chip);
  }
</style>
