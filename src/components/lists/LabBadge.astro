---
/**
 * Marks an article with an interactive lab: a widget the reader can play with.
 * Styled by `.lab-badge` and `.lab-icon` in src/styles/search.css, because the search scripts
 * draw the same badge on their results, on every page.
 */
import type { LangCode } from '@i18n/languages';
import { t } from '@i18n/t';
import { LAB_ICON_PATH } from '@lib/lab-icon';

interface Props {
  lang: LangCode;
  /** Only the icon (its name is still read out), for tight rows such as the Explore tree. */
  compact?: boolean;
}
const { lang, compact = false } = Astro.props;
---
<span class:list={['lab-badge', { compact }]} title={t(lang, 'lab.has')} data-pagefind-ignore>
  <svg class="lab-icon" viewBox="0 0 24 24" aria-hidden="true"
    ><path d={LAB_ICON_PATH} /></svg
  >{compact ? <span class="visually-hidden">{t(lang, 'lab.has')}</span> : <span>{t(lang, 'lab.badge')}</span>}
</span>
