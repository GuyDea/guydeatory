---
/** Marks an article with an interactive lab: a widget the reader can play with. */
import type { LangCode } from '@i18n/languages';
import { t } from '@i18n/t';
import { LAB_ICON_PATH } from '@lib/lab-icon';

interface Props {
  lang: LangCode;
  /** Only the icon (its name is still read out), for tight rows such as the Explore tree. */
  compact?: boolean;
}
const { lang, compact = false } = Astro.props;
---
<span class:list={['lab-badge', { compact }]} title={t(lang, 'lab.has')} data-pagefind-ignore>
  <svg viewBox="0 0 24 24" aria-hidden="true"
    ><path d={LAB_ICON_PATH} /></svg
  >{compact ? <span class="visually-hidden">{t(lang, 'lab.has')}</span> : <span>{t(lang, 'lab.badge')}</span>}
</span>

<!-- Global: the search scripts render the same badge on their results. -->
<style is:global>
  .lab-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    padding: 0.1em 0.6em 0.1em 0.45em;
    border-radius: var(--radius-pill);
    background: var(--accent-soft);
    color: var(--accent);
    font-family: var(--font-display-stack);
    font-weight: 700;
    font-size: 0.8rem;
    line-height: 1.6;
    white-space: nowrap;
  }

  .lab-badge.compact {
    padding: 0.2em;
  }

  .lab-badge svg {
    width: 1.15em;
    height: 1.15em;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
