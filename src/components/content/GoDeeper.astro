---
/** Collapsible depth for grown-ups: formulas, precise terms, where an analogy breaks. Still indexed for search. */
import type { LangCode } from '@i18n/languages';
import { t } from '@i18n/t';

interface Props {
  lang: LangCode;
  /** What this deeper part is about, e.g. "Why the water analogy is not perfect". */
  title?: string;
}
const { lang, title } = Astro.props;
---
<details class="go-deeper">
  <summary>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M6 12h12M9 17h6" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"></path></svg>
    <span class="go-deeper-title"><span data-pagefind-ignore>{t(lang, 'content.goDeeper')}{title && ': '}</span>{title}</span>
    <span class="go-deeper-hint" data-pagefind-ignore>{t(lang, 'content.goDeeperHint')}</span>
  </summary>
  <div class="go-deeper-body">
    <slot />
  </div>
</details>

<style>
  .go-deeper {
    max-width: var(--measure);
    background: var(--surface-sunk);
    border-radius: var(--radius-md);
    box-shadow: inset 0 2px 6px rgb(26 38 64 / 0.12);
  }

  summary {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: var(--space-3);
    align-items: center;
    min-height: var(--touch);
    padding: var(--space-3) var(--space-4);
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary svg {
    grid-row: span 2;
    width: 26px;
    height: 26px;
    color: var(--label-violet);
    transition: transform 0.2s ease;
  }

  .go-deeper[open] summary svg {
    transform: rotate(180deg);
  }

  .go-deeper-title {
    font-family: var(--font-display-stack);
    font-weight: 700;
    line-height: 1.25;
  }

  .go-deeper-hint {
    font-size: var(--text-sm);
    color: var(--ink-soft);
  }

  .go-deeper-body {
    padding: 0 var(--space-5) var(--space-5);
  }

  .go-deeper-body > :global(* + *) {
    margin-top: 1em;
  }
</style>
