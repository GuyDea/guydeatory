---
import type { LangCode } from '@i18n/languages';
import { t } from '@i18n/t';
import Callout from './Callout.astro';

interface Props {
  lang: LangCode;
  /** Optional heading instead of the default "Stay safe". */
  title?: string;
}
const { lang, title } = Astro.props;
---
<Callout kind="safety" heading={title ?? t(lang, 'content.safety')}><slot /></Callout>
