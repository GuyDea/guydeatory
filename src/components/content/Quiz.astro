---
/**
 * "Check yourself": one multiple-choice question.
 * Without JavaScript the options stay inert and the answer sits behind a "Show the answer" toggle.
 */
import type { LangCode } from '@i18n/languages';
import { t } from '@i18n/t';

interface Props {
  lang: LangCode;
  question: string;
  options: string[];
  /** Index of the correct option (0-based). */
  answer: number;
  explanation: string;
}
const { lang, question, options, answer, explanation } = Astro.props;
if (!Number.isInteger(answer) || answer < 0 || answer >= options.length) {
  throw new Error(`<Quiz> "${question}": answer ${answer} is not a valid option index (0–${options.length - 1})`);
}
---
<section class="quiz" data-quiz data-answer={answer} data-correct={t(lang, 'quiz.correct')} data-wrong={t(lang, 'quiz.wrong')}>
  <p class="quiz-label">{t(lang, 'quiz.label')}</p>
  <p class="quiz-question">{question}</p>
  <div class="quiz-options" role="group" aria-label={question}>
    {
      options.map((option, index) => (
        <button type="button" class="quiz-option" data-index={index} disabled>
          {option}
        </button>
      ))
    }
  </div>
  <p class="quiz-feedback" aria-live="polite"></p>
  <details class="quiz-reveal">
    <summary>{t(lang, 'quiz.reveal')}</summary>
    <p><strong>{options[answer]}</strong> — {explanation}</p>
  </details>
  <p class="quiz-explanation" hidden>{explanation}</p>
</section>

<script>
  for (const quiz of document.querySelectorAll<HTMLElement>('[data-quiz]')) {
    const answer = Number(quiz.dataset.answer);
    const feedback = quiz.querySelector<HTMLElement>('.quiz-feedback')!;
    const explanation = quiz.querySelector<HTMLElement>('.quiz-explanation')!;
    const buttons = [...quiz.querySelectorAll<HTMLButtonElement>('.quiz-option')];
    quiz.querySelector<HTMLElement>('.quiz-reveal')!.hidden = true;
    for (const button of buttons) {
      button.disabled = false;
      button.setAttribute('aria-pressed', 'false');
      button.addEventListener('click', () => {
        const correct = Number(button.dataset.index) === answer;
        button.setAttribute('aria-pressed', 'true');
        button.dataset.result = correct ? 'correct' : 'wrong';
        feedback.textContent = correct ? (quiz.dataset.correct ?? '') : (quiz.dataset.wrong ?? '');
        feedback.dataset.result = correct ? 'correct' : 'wrong';
        if (correct) {
          explanation.hidden = false;
          for (const other of buttons) if (other !== button) other.disabled = true;
        } else {
          button.disabled = true;
        }
      });
    }
  }
</script>

<style>
  .quiz {
    max-width: var(--measure);
    padding: var(--space-5);
    background: var(--surface);
    border: 2px solid var(--label-green);
    border-radius: var(--radius-lg);
  }

  .quiz-label {
    font-family: var(--font-display-stack);
    font-weight: 750;
    color: var(--label-green);
  }

  .quiz-question {
    margin-top: var(--space-2);
    font-size: var(--text-lg);
    font-weight: 700;
  }

  .quiz-options {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }

  .quiz-option {
    min-height: var(--touch);
    padding: var(--space-2) var(--space-4);
    text-align: left;
    background: var(--paper);
    border: 2px solid var(--line-strong);
    border-radius: var(--radius-md);
    line-height: 1.35;
  }

  .quiz-option:not(:disabled):hover {
    border-color: var(--accent);
  }

  .quiz-option:disabled {
    cursor: default;
  }

  .quiz-option[data-result='correct'] {
    border-color: var(--safe);
    background: var(--label-green-bg);
    font-weight: 700;
  }

  .quiz-option[data-result='wrong'] {
    border-color: var(--danger);
    text-decoration: line-through;
    opacity: 0.75;
  }

  .quiz-feedback {
    min-height: 1.6em;
    margin-top: var(--space-3);
    font-weight: 700;
  }

  .quiz-feedback[data-result='correct'] {
    color: var(--safe);
  }

  .quiz-feedback[data-result='wrong'] {
    color: var(--danger);
  }

  .quiz-reveal {
    margin-top: var(--space-2);
  }

  .quiz-reveal summary {
    min-height: var(--touch);
    display: flex;
    align-items: center;
    cursor: pointer;
    color: var(--accent);
    font-weight: 700;
  }
</style>
