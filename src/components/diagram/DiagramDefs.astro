---
/**
 * Shared SVG definitions (arrowheads) for every diagram on the page. Rendered once per article.
 * Diagrams reference them with marker-end: url(#d-arrow) etc. (see src/styles/diagram.css).
 */
const arrows = [
  { id: 'd-arrow', color: 'var(--d-ink)' },
  { id: 'd-arrow-accent', color: 'var(--d-accent)' },
  { id: 'd-arrow-electron', color: 'var(--d-electron)' },
  { id: 'd-arrow-hot', color: 'var(--d-hot)' },
  { id: 'd-arrow-cold', color: 'var(--d-cold)' },
  { id: 'd-arrow-muted', color: 'var(--d-muted)' },
];
---
<svg class="diagram-defs" width="0" height="0" aria-hidden="true" focusable="false">
  <defs>
    {
      arrows.map(({ id, color }) => (
        <marker id={id} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
          <path d="M0 0 10 5 0 10z" style={`fill: ${color}`} />
        </marker>
      ))
    }
  </defs>
</svg>

<style>
  .diagram-defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }
</style>
