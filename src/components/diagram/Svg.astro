---
/**
 * Accessible, responsive wrapper for a static diagram. Draw with the classes in src/styles/diagram.css
 * so colours follow the light/dark theme. Always give a title and a description of what it shows.
 */
interface Props {
  viewBox: string;
  title: string;
  desc: string;
  /** Upper width limit, e.g. "32rem"; the diagram shrinks to fit small screens. */
  maxWidth?: string;
}
const { viewBox, title, desc, maxWidth } = Astro.props;
const id = `d-${Math.random().toString(36).slice(2, 9)}`;
---
<svg class="diagram" viewBox={viewBox} role="img" aria-labelledby={`${id}-t ${id}-d`} style={maxWidth ? `max-width: ${maxWidth}` : undefined}>
  <title id={`${id}-t`}>{title}</title>
  <desc id={`${id}-d`}>{desc}</desc>
  <slot />
</svg>
