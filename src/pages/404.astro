---
/**
 * The one static /404.html that CloudFront serves for every missing path, in the reader's language.
 *
 * The page holds the header, the message and the footer in every language. An inline script in
 * <head> reads the path the reader tried (/sk/… → Slovak, any other path → English) and marks
 * <html> before the first paint; the CSS below then shows only that language. The switch is CSS on
 * purpose: `[hidden]` always wins (base.css), so it could not be undone before the first paint.
 *
 * Without JavaScript: the English header and footer, and the message in every language, English
 * first.
 *
 * BaseLayout renders its header and footer in one language only, so this page builds its own
 * document. Keep its <head> in step with src/layouts/BaseLayout.astro (tests/not-found.test.ts
 * compares the essentials).
 */
import { Font } from 'astro:assets';
import '@styles/tokens.css';
import '@styles/base.css';
import SearchDialog from '@components/search/SearchDialog.astro';
import SiteFooter from '@components/site/SiteFooter.astro';
import SiteHeader from '@components/site/SiteHeader.astro';
import { DEFAULT_LANG, LANG_CODES } from '@i18n/languages';
import type { LangCode } from '@i18n/languages';
import { t } from '@i18n/t';
import { absolute, homeAlternates, homeUrl, sectionUrl } from '@lib/urls';

const copy: Record<LangCode, { title: string; body: string; search: string; home: string }> = {
  en: { title: 'We could not find that page', body: 'The link may be old or mistyped. Try searching, or start again from the home page.', search: 'Search', home: 'Home' },
  sk: { title: 'Túto stránku sme nenašli', body: 'Odkaz môže byť starý alebo s preklepom. Skús vyhľadávanie alebo začni znova na úvodnej stránke.', search: 'Hľadať', home: 'Domov' },
};
const alternates = homeAlternates();
const otherLangs = LANG_CODES.filter((code) => code !== DEFAULT_LANG);

// Everything marked data-for-lang belongs to one language. Once the head script has set
// data-page-lang, only that language shows; before (or without JS), the default language's chrome.
const languageCss = [
  '.nf-chrome { display: contents; }',
  `html:not([data-page-lang]) .nf-chrome:not([data-for-lang="${DEFAULT_LANG}"]) { display: none; }`,
  ...LANG_CODES.map((code) => `html[data-page-lang="${code}"] [data-for-lang]:not([data-for-lang="${code}"]) { display: none; }`),
].join('\n');
---
<!doctype html>
<html lang={DEFAULT_LANG} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>404 – {t(DEFAULT_LANG, 'site.name')}</title>
    <meta name="description" content={copy[DEFAULT_LANG].title} />
    <link rel="canonical" href={absolute('/404.html')} />
    <meta name="robots" content="noindex" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f6f8fb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e1729" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Font cssVariable="--font-body" preload={[{ weight: 400, style: 'normal', subset: 'latin' }]} />
    <Font cssVariable="--font-display" preload={[{ subset: 'latin' }]} />
    <script is:inline>
      // Apply the saved colour theme before first paint (no flash).
      try {
        var saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch (e) {}
    </script>
    <script is:inline define:vars={{ codes: LANG_CODES, fallback: DEFAULT_LANG }}>
      // Speak the language of the path the reader tried (/sk/… → sk), before first paint.
      var first = location.pathname.split('/')[1];
      var lang = codes.indexOf(first) === -1 ? fallback : first;
      document.documentElement.lang = lang;
      document.documentElement.setAttribute('data-page-lang', lang);
    </script>
    <style is:inline set:html={languageCss}></style>
  </head>
  <body>
    {
      LANG_CODES.map((code) => (
        <div class="nf-chrome" data-for-lang={code} lang={code}>
          <a class="skip-link" href="#main">{t(code, 'a11y.skipToContent')}</a>
          <SiteHeader lang={code} alternates={alternates} />
        </div>
      ))
    }
    <main id="main" tabindex="-1">
      <div class="page not-found">
        {
          LANG_CODES.map((code) => (
            <section lang={code} data-for-lang={code}>
              <h1>{copy[code].title}</h1>
              <p>{copy[code].body}</p>
              <p class="actions">
                <a href={sectionUrl(code, 'search')}>{copy[code].search}</a>
                <a href={homeUrl(code)}>{copy[code].home}</a>
              </p>
            </section>
          ))
        }
      </div>
    </main>
    {
      LANG_CODES.map((code) => (
        <div class="nf-chrome" data-for-lang={code} lang={code}>
          <SiteFooter lang={code} alternates={alternates} />
        </div>
      ))
    }
    <SearchDialog lang={DEFAULT_LANG} />
    {
      otherLangs.map((code) => (
        <template data-search-for={code}>
          <SearchDialog lang={code} />
        </template>
      ))
    }
    <script is:inline>
      // The quick-search dialog speaks the page language too. The default one is live, the others
      // wait in <template>s (one id="search-data" per page). The search script is a module, so it
      // runs after this swap and finds the right one.
      (function () {
        var lang = document.documentElement.getAttribute('data-page-lang');
        var template = lang && document.querySelector('template[data-search-for="' + lang + '"]');
        var data = document.getElementById('search-data');
        var dialog = document.querySelector('[data-search-dialog]');
        if (!template || !data || !dialog) return;
        var content = template.content;
        data.replaceWith(document.importNode(content.querySelector('#search-data'), true));
        dialog.replaceWith(document.importNode(content.querySelector('[data-search-dialog]'), true));
      })();
    </script>
  </body>
</html>

<style>
  .not-found {
    padding-block: var(--space-8);
    display: grid;
    gap: var(--space-7);
  }

  h1 {
    font-size: var(--text-h2);
    font-weight: 800;
    margin-bottom: var(--space-3);
  }

  .actions {
    display: flex;
    gap: var(--space-5);
    margin-top: var(--space-4);
    font-weight: 700;
  }
</style>
