---
import { LANG_CODES } from '@i18n/languages';
import type { LangCode } from '@i18n/languages';
import HomeView from '@views/HomeView.astro';

export function getStaticPaths() {
  return LANG_CODES.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as LangCode;
---
<HomeView lang={lang} />
