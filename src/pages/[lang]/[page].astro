---
/**
 * Every page one level below a language: articles (/sk/napatie/) and the localized
 * system sections (/sk/objavuj/, /sk/hladaj/, /sk/o-projekte/). They share one route
 * because their URLs have the same shape; the catalog rejects article slugs that clash.
 */
import { LANGUAGES } from '@i18n/languages';
import type { LangCode } from '@i18n/languages';
import { getCatalog } from '@lib/content/catalog';
import AboutView from '@views/AboutView.astro';
import ArticleView from '@views/ArticleView.astro';
import ExploreView from '@views/ExploreView.astro';
import SearchView from '@views/SearchView.astro';

type Props = { kind: 'article'; id: string } | { kind: 'explore' | 'search' | 'about' };

export async function getStaticPaths() {
  const catalog = await getCatalog();
  return LANGUAGES.flatMap((language) => {
    const lang = language.code;
    const sections = (['explore', 'search', 'about'] as const).map((kind) => ({
      params: { lang, page: language.sections[kind] },
      props: { kind } satisfies Props,
    }));
    const articles = [...catalog.articles.values()].flatMap((article) => {
      const text = article.texts[lang];
      return text ? [{ params: { lang, page: text.slug }, props: { kind: 'article', id: article.id } satisfies Props }] : [];
    });
    return [...sections, ...articles];
  });
}

const lang = Astro.params.lang as LangCode;
const props = Astro.props as Props;
---
{props.kind === 'article' && <ArticleView lang={lang} id={props.id} />}
{props.kind === 'explore' && <ExploreView lang={lang} />}
{props.kind === 'about' && <AboutView lang={lang} />}
{props.kind === 'search' && <SearchView lang={lang} />}
