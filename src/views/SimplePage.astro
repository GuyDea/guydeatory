---
/** Shared frame for system pages (explore, search, about, topics, home) until their full views exist. */
import type { LangCode } from '@i18n/languages';
import BaseLayout from '@layouts/BaseLayout.astro';
import type { Alternate } from '@lib/urls';

interface Props {
  lang: LangCode;
  title: string;
  description: string;
  canonical: string;
  alternates: Alternate[];
  current?: 'explore' | 'about' | 'search' | undefined;
  noindex?: boolean;
}
const props = Astro.props;
---
<BaseLayout {...props}>
  <div class="page simple">
    <h1>{props.title}</h1>
    <slot />
  </div>
</BaseLayout>

<style>
  .simple {
    padding-block: var(--space-7);
  }

  h1 {
    font-size: var(--text-h1);
    font-weight: 800;
    margin-bottom: var(--space-5);
  }
</style>
